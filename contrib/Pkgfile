# Description: Cross-platform system information tool written in Bash
# URL: https://github.com/ximimoments/katifetch
# Depends on: pciutils

name=katifetch
version=13.1
release=3
source=(https://github.com/ximimoments/katifetch/archive/refs/tags/$version.tar.gz)

build() {
    cd $name-$version
    install -Dm755 katifetch.sh "$PKG/usr/local/bin/katifetch"
}
